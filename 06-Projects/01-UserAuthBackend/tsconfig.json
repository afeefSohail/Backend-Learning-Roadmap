{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  // 🟢 Maps the type tracking directly to your active TypeScript source folders!
  "paths": {
    "#routes/*": ["./src/routes/*"],
    "#controllers/*": ["./src/controllers/*"],
    "#middlewares/*": ["./src/middlewares/*"],
    "#validators/*": ["./src/validators/*"],
    "#utils/*": ["./src/utils/*"]
  },
  
  "include": [
    "main.ts",                     // 🟢 Include root file 1 explicitly
    "app.ts",                      // 🟢 Include root file 2 explicitly
    "src/**/*.ts"                  // 🟢 Include your nested routes recursively
  ]
}
