          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Photos"
        ],
        "summary": "Upload one or more photos",
        "description": "",
        "consumes": [
          "multipart/form-data"
