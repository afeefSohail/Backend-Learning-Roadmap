{
  "swagger": "2.0",
  "info": {
    "title": "User Auth API",
    "description": "Auto-generated Swagger documentation for phone/email auth, user profiles, and photo uploads.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Auth",
