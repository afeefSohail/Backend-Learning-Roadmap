      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get a user's public profile",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the public profile"
          },
          "404": {
