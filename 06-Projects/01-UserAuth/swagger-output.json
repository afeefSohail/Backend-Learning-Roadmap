            "description": "Photo ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Photo deleted successfully"
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
