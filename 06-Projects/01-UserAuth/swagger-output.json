            "name": "photoId",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Photo ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the user's public photo"
          },
          "404": {
            "description": "User not found"
